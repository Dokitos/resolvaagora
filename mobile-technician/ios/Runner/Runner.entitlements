<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Capability "Push Notifications" (APNs), usada pelo firebase_messaging.
	     Fixo em "production": contava-se que a exportacao para App Store o
	     trocasse a partir de "development", mas nao aconteceu — o iPhone
	     ficava sem token APNs (registerForRemoteNotifications falha sem uma
	     aps-environment valida para o perfil) e nenhuma push chegava.
	     Todas as builds saem do Codemagic com perfil de distribuicao App
	     Store, por isso "production" e o valor correto; uma build de
	     desenvolvimento local exigiria trocar isto de volta. -->
	<key>aps-environment</key>
	<string>production</string>
	<!-- Capability "Sign in with Apple". ATENCAO: tem de estar ativada tambem
	     no App ID em developer.apple.com antes da proxima build, senao o
	     perfil de distribuicao sai sem ela e a assinatura falha. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
